# JalRakshak Environment Configuration
# Copy this file to .env and fill in your values

# ──# Supabase Auth Settings (backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API Settings──────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Current supported model (gemini-2.0-flash deprecated June 2026)
GEMINI_MODEL=gemini-2.5-flash

# ── Application ────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/water_quality.db

# ── CORS ───────────────────────────────────────────────────────
# Frontend origin (Vite default)
FRONTEND_ORIGIN=http://localhost:5173

# ── Data paths ─────────────────────────────────────────────────
RAW_DATA_PATH=./data/raw/India_Water_Quality_Dataset_50000.csv
PROCESSED_DATA_PATH=./data/processed/water_quality_clean.csv

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── TTS (Bhashini adapter) ─────────────────────────────────────
# Leave blank to use browser TTS demo mode
BHASHINI_API_KEY=
BHASHINI_USER_ID=
